{
  "tasks": {
    "validate": "deno run --allow-read --allow-write validate/main.ts",
    "validate:check": "deno run --allow-read validate/main.ts --check",
    "lint": "deno run --allow-read lint/main.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8"
  }
}
